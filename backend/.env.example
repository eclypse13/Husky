# Django
DEBUG=True
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_NAME=nkp_husky

# PostgreSQL (dogs module)
DOGS_DB_NAME=dogs
DOGS_DB_USER=dogs_user
DOGS_DB_PASSWORD=dogs_password
